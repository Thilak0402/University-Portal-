pipeline {
    agent any
    environment {
        DOCKER_CREDS = credentials('dockerhub-credentials')
        IMAGE_NAME = 'thilak0402/university-portal'
        TAG = "${BUILD_NUMBER}"
    }
    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/Thilak0402/University-Portal-.git'
            }
        }
        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -t ${IMAGE_NAME}:${TAG} -t ${IMAGE_NAME}:latest ."
                }
            }
        }
        stage('Push to Docker Hub') {
            steps {
                script {
                    sh "echo ${DOCKER_CREDS_PSW} | docker login -u ${DOCKER_CREDS_USR} --password-stdin"
                    sh "docker push ${IMAGE_NAME}:${TAG}"
                    sh "docker push ${IMAGE_NAME}:latest"
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                withKubeConfig(credentialsId: 'k8s-config', serverUrl: '') {
                    script {
                        // Update deployment image tag dynamically
                        sh "sed -i 's|image:.*|image: ${IMAGE_NAME}:${TAG}|g' deployment.yaml"
                        sh "kubectl apply -f deployment.yaml"
                        sh "kubectl apply -f service.yaml"
                    }
                }
            }
        }
        stage('Deployment Health Check') {
            steps {
                withKubeConfig(credentialsId: 'k8s-config', serverUrl: '') {
                    // Wait for rollout status with health checks
                    sh "kubectl rollout status deployment/university-portal --timeout=60s"
                }
            }
        }
    }
    post {
        failure {
            script {
                echo "Pipeline failed or health check failed! Initiating automated rollback..."
                withKubeConfig(credentialsId: 'k8s-config', serverUrl: '') {
                    sh "kubectl rollout undo deployment/university-portal"
                }
            }
        }
    }
}